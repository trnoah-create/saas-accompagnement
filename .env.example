# ─── Mot de passe d'accès au site (OBLIGATOIRE) ─────────────────────
# Sans cette variable, le site est entièrement verrouillé : personne ne
# peut entrer, toi compris. À définir dans Vercel → Settings →
# Environment Variables. Ne jamais l'écrire dans le code ni sur GitHub.
SITE_PASSWORD=

# ─── Base de données PostgreSQL (OBLIGATOIRE) ───────────────────────
# Renseignée automatiquement par l'intégration Neon de Vercel.
DATABASE_URL=

# Nombre maximal de connexions simultanées, selon les limites de
# l'hébergeur (sans effet avec le pilote HTTP de Neon).
# DATABASE_POOL_MAX=3

# ─── Prix de marché ─────────────────────────────────────────────────
# Aucune clé API : Binance et Stooq sont interrogés librement.
