# ─── Mot de passe d'accès au site (OBLIGATOIRE) ─────────────────────
# Sans cette variable, le site est entièrement verrouillé.
SITE_PASSWORD=

# ─── Base de données PostgreSQL (OBLIGATOIRE) ───────────────────────
# Renseignée automatiquement par l'intégration Neon de Vercel.
DATABASE_URL=
# DATABASE_POOL_MAX=3

# ─── Mode « Claude trader » (facultatif) ────────────────────────────
# Clé de l'API Anthropic. Sans elle, la tâche quotidienne ne passe
# aucun ordre et le signale dans le compte rendu.
ANTHROPIC_API_KEY=

# Secret protégeant l'adresse de la tâche quotidienne. Vercel le génère
# automatiquement quand un cron est configuré ; sinon, invente une longue
# chaîne aléatoire. Sans lui, l'adresse est fermée.
CRON_SECRET=

# ─── Prix de marché ─────────────────────────────────────────────────
# Aucune clé : Binance, Coinbase, Kraken, CoinGecko, Stooq, Yahoo, FRED.
