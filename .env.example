# ─── Formulaire de contact (/discussion) ────────────────────────────
# Sans ces variables, le formulaire s'affiche mais affiche un message
# invitant à écrire directement à l'adresse de contact.
# Clé API Resend (https://resend.com) :
RESEND_API_KEY=
# Expéditeur — doit appartenir à un domaine vérifié chez Resend :
CONTACT_FROM_EMAIL="MonProjet <contact@ton-domaine.fr>"
# Destinataire ; par défaut, l'e-mail défini dans config/site.ts :
CONTACT_TO_EMAIL=

# ─── Accès Discord réservé à l'offre Accompagnement ─────────────────
# ⚠️ Variable SERVEUR : ne jamais la préfixer par NEXT_PUBLIC_, sinon
# le lien serait injecté dans le bundle JS et deviendrait public.
# Utiliser une invitation révocable, pas un lien permanent.
DISCORD_INVITE_URL=

# ─── Aperçu local uniquement ────────────────────────────────────────
# Simule un utilisateur ayant acheté une offre, pour visualiser la page
# /discussion telle que la verra un membre. Sans effet en production.
# Valeurs acceptées : formation | accompagnement
# DEV_PREVIEW_ENTITLEMENT=accompagnement
